{
  "name": "dotnet-testing-plus",
  "displayName": ".NET Testing+",
  "description": "Filter, run, and debug tests from .NET solutions using Visual Studio playlists, advanced filters, and runsettings.",
  "version": "1.24.1",
  "icon": "assets/icon.png",
  "publisher": "RisingFisan",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/RisingFisan/vscode-dotnet-testing-plus.git"
  },
  "engines": {
    "vscode": "^1.94.0"
  },
  "categories": [
    "Testing"
  ],
  "activationEvents": [
    "onView:workbench.view.testing",
    "workspaceContains:**/*.sln",
    "workspaceContains:**/*.slnf",
    "workspaceContains:**/*.slnx",
    "workspaceContains:**/*.csproj"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": ".NET Testing+",
      "properties": {
        "dotnetTestingPlus.playlistSaveFormat": {
          "type": "string",
          "enum": [
            "v2",
            "v1"
          ],
          "default": "v2",
          "enumDescriptions": [
            "V2 rule-based playlist with FullyQualifiedName properties (what Visual Studio writes).",
            "Legacy <Add Test=\"...\"/> entries."
          ],
          "description": "File format written by 'Save As Playlist'."
        },
        "dotnetTestingPlus.skipPreBreakpoint": {
          "type": "boolean",
          "default": true,
          "description": "When debugging, automatically continue past the test host's initial Debugger.Break() (triggered by VSTEST_HOST_DEBUG) so the run starts without a manual Continue."
        },
        "dotnetTestingPlus.controlApiEnabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable or disable the shared local JSON HTTP control API for external agents and tools. All VS Code windows with the API enabled share one API; the first window hosts it and the others join."
        },
        "dotnetTestingPlus.controlApiPort": {
          "type": "number",
          "default": 48265,
          "minimum": 0,
          "maximum": 65535,
          "description": "Port for the shared JSON control API (default: 48265). Only the window that hosts the API uses this value; other windows discover the host automatically. The setting is usually best set at the user level so every window agrees."
        },
        "dotnetTestingPlus.controlApiToken": {
          "type": "string",
          "default": "",
          "description": "Optional bearer token the control API requires in the Authorization header. Leave empty to disable auth (the API still only accepts loopback connections)."
        },
        "dotnetTestingPlus.runsettingsOverrides": {
          "type": "object",
          "default": {},
          "description": "Permanent runsettings overrides applied on top of the base runsettings file."
        },
        "dotnetTestingPlus.diagnostics.retainRuns": {
          "type": "number",
          "default": 20,
          "minimum": 0,
          "description": "How many runs that do not pass (failures, errors, cancellations) keep their full diagnostics on disk. 0 disables retention entirely: stdout/stderr are then logged with an explicit per-chunk cap and nothing is kept after a run. Diagnostics live in extension storage, never in the workspace."
        },
        "dotnetTestingPlus.diagnostics.retainTotalMb": {
          "type": "number",
          "default": 200,
          "minimum": 0,
          "description": "Size budget, in MB, for retained run diagnostics. Older runs are pruned first; 0 means no size limit."
        },
        "dotnetTestingPlus.diagnostics.retainDays": {
          "type": "number",
          "default": 14,
          "minimum": 0,
          "description": "Retained run diagnostics older than this many days are pruned (the newest run is always kept); 0 means no age limit."
        }
      }
    },
    "commands": [
      {
        "command": "dotnet-testing-plus.addSolution",
        "title": "Add Solution...",
        "category": ".NET Testing+",
        "icon": "$(add)"
      },
      {
        "command": "dotnet-testing-plus.removeSolution",
        "title": "Unload Selected Solution",
        "category": ".NET Testing+",
        "icon": "$(close)"
      },
      {
        "command": "dotnet-testing-plus.stopLoading",
        "title": "Stop Loading Solution",
        "category": ".NET Testing+",
        "icon": "$(debug-stop)"
      },
      {
        "command": "dotnet-testing-plus.selectPlaylist",
        "title": "Select Playlist File...",
        "category": ".NET Testing+",
        "icon": "$(list-flat)"
      },
      {
        "command": "dotnet-testing-plus.refresh",
        "title": "Refresh Tests",
        "category": ".NET Testing+",
        "icon": "$(refresh)"
      },
      {
        "command": "dotnet-testing-plus.clearPlaylist",
        "title": "Clear Playlist",
        "category": ".NET Testing+",
        "icon": "$(clear-all)"
      },
      {
        "command": "dotnet-testing-plus.showOutput",
        "title": "Show Output",
        "category": "Test Playlist Filter"
      },
      {
        "command": "dotnet-testing-plus.selectRunsettings",
        "title": "Select Runsettings File",
        "category": ".NET Testing+",
        "icon": "$(gear)"
      },
      {
        "command": "dotnet-testing-plus.useDefaultRunsettings",
        "title": "Use Default Runsettings File",
        "category": ".NET Testing+",
        "icon": "$(refresh)"
      },
      {
        "command": "dotnet-testing-plus.clearRunsettings",
        "title": "Clear Runsettings Selection",
        "category": ".NET Testing+",
        "icon": "$(clear-all)"
      },
      {
        "command": "dotnet-testing-plus.runAll",
        "title": "Run All Loaded Solution Tests",
        "category": ".NET Testing+",
        "icon": "$(run-all)",
        "enablement": "dotnetTestingPlus.solutionReady"
      },
      {
        "command": "dotnet-testing-plus.debugAll",
        "title": "Debug All Loaded Solution Tests",
        "category": ".NET Testing+",
        "icon": "$(debug-alt)",
        "enablement": "dotnetTestingPlus.solutionReady"
      },
      {
        "command": "dotnet-testing-plus.runTestFromCodeLens",
        "title": "Run Test (CodeLens)",
        "category": ".NET Testing+"
      },
      {
        "command": "dotnet-testing-plus.debugTestFromCodeLens",
        "title": "Debug Test (CodeLens)",
        "category": ".NET Testing+"
      },
      {
        "command": "dotnet-testing-plus.installAgentSkill",
        "title": "Install Agent Skill...",
        "category": ".NET Testing+"
      },
      {
        "command": "dotnet-testing-plus.showRunDiagnostics",
        "title": "Show Run Diagnostics...",
        "category": ".NET Testing+"
      },
      {
        "command": "dotnet-testing-plus.clearRunDiagnostics",
        "title": "Delete Retained Run Diagnostics",
        "category": ".NET Testing+"
      },
      {
        "command": "dotnet-testing-plus.goToCallSite",
        "title": "Go to Call Site in Test",
        "category": ".NET Testing+"
      },
      {
        "command": "dotnet-testing-plus.goToErrorLocation",
        "title": "Go to Innermost Error Location",
        "category": ".NET Testing+"
      }
    ],
    "views": {
      "testing": [
        {
          "id": "dotnet-testing-plus.view",
          "name": ".NET Testing+",
          "type": "webview",
          "icon": "$(beaker)"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "dotnet-testing-plus.stopLoading",
          "when": "view == dotnet-testing-plus.view && dotnetTestingPlus.solutionLoading",
          "group": "navigation@1"
        },
        {
          "command": "dotnet-testing-plus.refresh",
          "when": "view == dotnet-testing-plus.view && dotnetTestingPlus.hasSolution && !dotnetTestingPlus.solutionLoading",
          "group": "navigation@2"
        },
        {
          "command": "dotnet-testing-plus.showOutput",
          "when": "view == dotnet-testing-plus.view",
          "group": "1_overflow@1"
        },
        {
          "command": "dotnet-testing-plus.installAgentSkill",
          "when": "view == dotnet-testing-plus.view",
          "group": "1_overflow@2"
        },
        {
          "command": "dotnet-testing-plus.showRunDiagnostics",
          "when": "view == dotnet-testing-plus.view",
          "group": "1_overflow@3"
        }
      ],
      "testing/item/context": [
        {
          "command": "dotnet-testing-plus.goToCallSite",
          "when": "testItemHasFailures",
          "group": "navigation@1"
        },
        {
          "command": "dotnet-testing-plus.goToErrorLocation",
          "when": "testItemHasFailures",
          "group": "navigation@2"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "harness": "node harness/diagnostics.js",
    "vscode:prepublish": "npm run compile"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.0",
    "web-tree-sitter": "^0.27.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.94.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.56.0",
    "typescript": "^5.4.0"
  }
}
